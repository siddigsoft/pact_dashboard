{
  "buildCommand": "npm run build",
  "functions": {
    "api/extract-transaction.ts": {
      "maxDuration": 60
    },
    "api/generate-survey-questions.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(service-worker.js|firebase-messaging-sw.js|index.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|js/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
